generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ErrorLog {
  id        Int       @id @default(autoincrement())
  type      ErrorType @default(failed)
  createdAt DateTime  @default(now())
  error     String
}

enum ErrorType {
  rate_limit_exceeded
  failed
}
